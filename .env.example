# Copy this file to .env and fill it in. .env is not committed to git.

# Comma-separated emails that get the admin page and unlimited conversions.
# An admin signs up like anyone else, using one of these addresses.
ADMIN_EMAILS=you@example.com

# Mail account used to send verification codes.
# For Gmail: turn on 2-step verification, create an "app password", and paste it below.
# While SMTP_USER is empty, no mail is sent and codes are printed in the container log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: address shown as the sender (defaults to SMTP_USER).
MAIL_FROM=

# Address people use to reach the app; used for links in emails.
APP_URL=http://localhost:7777

# Conversions each new account starts with.
DEFAULT_QUOTA=10

# Set to 1 only when the app is served over https.
COOKIE_SECURE=0

# Behind an https reverse proxy (see deploy/nginx-site.conf): publish the container
# on a local-only port and trust the proxy's forwarded headers.
# BIND=127.0.0.1:7780
# TRUST_PROXY=1
